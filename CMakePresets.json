{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base", "hidden": true, "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "mac-base", "hidden": true, "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0" }
    },
    { "name": "mac-debug",   "displayName": "macOS Debug (native arch)",   "inherits": "mac-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "mac-release", "displayName": "macOS Release (native arch)", "inherits": "mac-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "mac-release-universal", "displayName": "macOS Release universal (arm64 + x86_64)", "inherits": "mac-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" } },
    { "name": "mac-rtsan", "displayName": "macOS Debug + RealtimeSanitizer (Homebrew LLVM; engine+tools+tests, no app)",
      "inherits": "mac-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "TERMINATOR_ENABLE_RTSAN": "ON",
        "TERMINATOR_BUILD_APP": "OFF"
      }
    },
    { "name": "mac-asan-ubsan", "displayName": "macOS Debug + ASan/UBSan (Apple clang; engine+tools+tests, no app)",
      "inherits": "mac-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "TERMINATOR_ENABLE_ASAN_UBSAN": "ON", "TERMINATOR_BUILD_APP": "OFF" } },
    {
      "name": "win-base", "hidden": true, "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    { "name": "win-debug",   "displayName": "Windows x64 Debug (run from a VS x64 developer shell)",   "inherits": "win-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "win-release", "displayName": "Windows x64 Release (run from a VS x64 developer shell)", "inherits": "win-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "mac-debug",             "configurePreset": "mac-debug" },
    { "name": "mac-release",           "configurePreset": "mac-release" },
    { "name": "mac-release-universal", "configurePreset": "mac-release-universal" },
    { "name": "mac-rtsan",             "configurePreset": "mac-rtsan" },
    { "name": "mac-asan-ubsan",        "configurePreset": "mac-asan-ubsan" },
    { "name": "win-debug",             "configurePreset": "win-debug" },
    { "name": "win-release",           "configurePreset": "win-release" }
  ],
  "testPresets": [
    { "name": "mac-debug",             "configurePreset": "mac-debug",             "output": { "outputOnFailure": true } },
    { "name": "mac-release",           "configurePreset": "mac-release",           "output": { "outputOnFailure": true } },
    { "name": "mac-release-universal", "configurePreset": "mac-release-universal", "output": { "outputOnFailure": true } },
    { "name": "mac-rtsan",             "configurePreset": "mac-rtsan",             "output": { "outputOnFailure": true } },
    { "name": "mac-asan-ubsan",        "configurePreset": "mac-asan-ubsan",        "output": { "outputOnFailure": true } },
    { "name": "win-debug",             "configurePreset": "win-debug",             "output": { "outputOnFailure": true } },
    { "name": "win-release",           "configurePreset": "win-release",           "output": { "outputOnFailure": true } }
  ]
}
