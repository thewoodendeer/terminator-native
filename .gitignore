# build output
build/
out/
cmake-build-*/
.cache/
*.o
*.obj
*.a
*.lib
*.dSYM/

# IDE / OS
.vs/
.vscode/
.idea/
*.user
*.swp
.DS_Store
CMakeUserPresets.json

# ui (Phase 2+)
ui/node_modules/
ui/dist/

# provisioned tools (yt-dlp + qjs downloads — cmake/ProvisionTools.cmake)
third_party/.tools-cache/

# the bundled drum library (80 MB of opaque-id one-shots — `node tools/fetch-drums.mjs` provisions it)
drums-flac/

# provisioned onnxruntime (cmake/Onnxruntime.cmake)
third_party/.ort-cache/

# provisioned Sparkle / WinSparkle, the updaters (cmake/Sparkle.cmake, cmake/WinSparkle.cmake)
third_party/.sparkle-cache/
third_party/.winsparkle-cache/

# never
.env
.env.*
Secrets.*
*.p8
*.p12
# an exported Sparkle private key — it belongs OUTSIDE the repo, never in it
*.pem
sparkle_priv*
*.cer
*.mobileprovision

# fetched SDKs (never committed — licence)
third_party/asiosdk*/
third_party/_fetched/

# local build/test logs + probe outputs
*.log
probe*.json

# release artefacts (tools/release/package-mac.sh) — ROOT-anchored: tools/release/ holds the scripts
/release/
